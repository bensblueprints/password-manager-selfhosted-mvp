# Vaultly configuration — copy to .env and edit

# Port the web app listens on
PORT=5344

# Instance setup password. Required ONLY to create the FIRST (admin) account,
# so a fresh public deployment can't be claimed by a stranger. It is NOT a
# vault key — vault encryption uses each user's master password, client-side.
ADMIN_PASSWORD=change-me

# SQLite database location (stores ciphertext only)
DB_PATH=./data/vaultly.db
